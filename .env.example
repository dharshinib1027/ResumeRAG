# Copy to .env (project root or backend/) and fill in
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Frontend origins allowed to call the API ("null" = index.html opened from disk)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,null
